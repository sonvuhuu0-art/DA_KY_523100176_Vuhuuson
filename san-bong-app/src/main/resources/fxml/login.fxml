<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sanbong.controller.LoginController">

    <VBox styleClass="auth-brand-pane" alignment="CENTER_LEFT" spacing="26" HBox.hgrow="ALWAYS">
        <padding>
            <Insets top="60" right="60" bottom="60" left="70"/>
        </padding>
        <Label text="ĐẶT LỊCH SÂN BÓNG" styleClass="auth-brand-title" wrapText="true" prefWidth="440"/>
        <Label text="Nền tảng kết nối khách hàng, chủ sân và quản trị viên trên cùng một hệ thống đặt sân bóng."
               styleClass="auth-brand-subtitle" wrapText="true" prefWidth="420" maxWidth="420"/>

        <VBox spacing="20" prefWidth="440" maxWidth="440">
            <VBox.margin>
                <Insets top="14"/>
            </VBox.margin>
            <HBox fx:id="feature1" spacing="14" alignment="CENTER_LEFT"/>
            <HBox fx:id="feature2" spacing="14" alignment="CENTER_LEFT"/>
            <HBox fx:id="feature3" spacing="14" alignment="CENTER_LEFT"/>
            <HBox fx:id="feature4" spacing="14" alignment="CENTER_LEFT"/>
        </VBox>
    </VBox>

    <VBox styleClass="auth-form-pane" alignment="CENTER" spacing="14" prefWidth="440" minWidth="420">
        <padding>
            <Insets top="40" right="48" bottom="40" left="48"/>
        </padding>
        <Label text="Đăng nhập" styleClass="auth-title"/>
        <Label text="Vui lòng đăng nhập để tiếp tục" styleClass="auth-subtitle"/>
        <VBox spacing="6" maxWidth="Infinity">
            <Label text="Email"/>
            <TextField fx:id="emailField" promptText="ban@email.com"/>
        </VBox>
        <VBox spacing="6" maxWidth="Infinity">
            <Label text="Mật khẩu"/>
            <PasswordField fx:id="passwordField" promptText="Mật khẩu"/>
        </VBox>
        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" managed="false" visible="false"/>
        <Button text="Đăng nhập" styleClass="btn-primary" maxWidth="Infinity" onAction="#handleLogin"/>
        <VBox spacing="4" alignment="CENTER">
            <Label text="Chưa có tài khoản?" styleClass="auth-subtitle"/>
            <Button text="Đăng ký ngay" styleClass="btn-link" onAction="#goToRegister"/>
        </VBox>
        <VBox styleClass="auth-info-box" spacing="4" maxWidth="Infinity">
            <Label text="TÀI KHOẢN DEMO" styleClass="auth-info-title"/>
            <Label text="Admin: admin@sanbong.local / admin123" styleClass="auth-info-text" wrapText="true"/>
            <Label text="Chủ sân: chusan1@sanbong.local / owner123" styleClass="auth-info-text" wrapText="true"/>
            <Label text="Khách hàng: khach1@sanbong.local / 123456" styleClass="auth-info-text" wrapText="true"/>
        </VBox>
    </VBox>
</HBox>
