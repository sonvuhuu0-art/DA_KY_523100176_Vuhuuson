<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<VBox spacing="14" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sanbong.controller.admin.CustomerManagementController">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Danh sách khách hàng" styleClass="section-title"/>
        <TextField fx:id="searchField" promptText="Tìm theo tên hoặc email..." prefWidth="260"/>
    </HBox>
    <TableView fx:id="customerTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFullName" text="Họ tên" prefWidth="180"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
            <TableColumn fx:id="colPhone" text="Số điện thoại" prefWidth="130"/>
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="110"/>
            <TableColumn fx:id="colAction" text="Hành động" prefWidth="140"/>
        </columns>
    </TableView>
</VBox>
