<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="20" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sanbong.controller.admin.VenueManagementController">

    <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="480">
        <Label text="Danh sách cụm sân" styleClass="section-title"/>
        <TableView fx:id="venueTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName" text="Tên cụm sân" prefWidth="160"/>
                <TableColumn fx:id="colOwner" text="Chủ sân" prefWidth="140"/>
                <TableColumn fx:id="colAddress" text="Địa chỉ" prefWidth="160"/>
                <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="110"/>
            </columns>
        </TableView>
    </VBox>

    <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="360">
        <Label text="Thêm / Sửa cụm sân" styleClass="section-title"/>
        <ComboBox fx:id="ownerCombo" promptText="Chủ sân" maxWidth="Infinity"/>
        <TextField fx:id="nameField" promptText="Tên cụm sân"/>
        <TextField fx:id="addressField" promptText="Địa chỉ"/>
        <TextField fx:id="phoneField" promptText="Số điện thoại"/>
        <ComboBox fx:id="statusCombo" promptText="Trạng thái" maxWidth="Infinity"/>
        <TextArea fx:id="descriptionField" promptText="Mô tả" prefRowCount="3"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <StackPane fx:id="imagePreview"/>
            <Button text="Chọn ảnh..." styleClass="btn-secondary" onAction="#handleChooseImage"/>
        </HBox>
        <HBox spacing="10">
            <Button text="Lưu" styleClass="btn-primary" onAction="#handleSave"/>
            <Button text="Xóa" styleClass="btn-secondary" onAction="#handleDelete"/>
            <Button text="Làm mới form" styleClass="btn-secondary" onAction="#handleClearForm"/>
        </HBox>
        <Label fx:id="messageLabel" styleClass="error-label" wrapText="true" managed="false" visible="false"/>
    </VBox>

    <padding>
        <Insets bottom="20"/>
    </padding>
</HBox>
